# ─────────────────────────────────────────────────────────────────────────
# Elbasani Raporton – every setting, with an explanation.
# Local development uses .env.development (committed, no secrets).
# On Vercel, set these in Project → Settings → Environment Variables:
#   "Production" = the live site, "Preview" = staging.
# Never commit real secrets. .env, .env.local, .env.production are git-ignored.
# ─────────────────────────────────────────────────────────────────────────

# development | staging | production | test. On Vercel it is derived from VERCEL_ENV when empty.
APP_ENV=
# Public address of the site. Used in emails and as the address QStash calls back.
APP_URL=https://raporto.elbasani.gov.al

# PostgreSQL. DATABASE_URL is used by the app (a pooled URL is fine);
# DIRECT_URL (optional) is used only by `prisma migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DIRECT_URL=

# Auth.js: encrypts the session cookie. At least 32 random characters:  npx auth secret
AUTH_SECRET=
# Hours a staff session stays valid.
SESSION_MAX_AGE_HOURS=12
# The only email allowed to create the first admin account (/hyrje/konfigurimi).
ADMIN_EMAIL=
BCRYPT_ROUNDS=11

# Vercel Blob (photos). Created automatically when you connect a Blob store to the project.
# Without it photos are kept in LOCAL_UPLOAD_DIR – development and tests only.
BLOB_READ_WRITE_TOKEN=
LOCAL_UPLOAD_DIR=.uploads
UPLOAD_MAX_MB=8

# Upstash Redis (cache, rate limits, session state). The Vercel integration may name them KV_REST_API_URL / KV_REST_API_TOKEN – both work.
# Without it an in-memory cache is used – development and tests only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (background jobs: emails, AI checks). Without it jobs run right
# after the response with Next.js after() – fine for development and small sites.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Cron sends this secret to /api/cron/daily (auto-close, overdue reminders, cleanup).
CRON_SECRET=

# Email: "log" keeps emails in the Email log only; "smtp" sends them.
MAIL_DRIVER=log
MAIL_FROM="Elbasani Raporton <noreply@elbasani.gov.al>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# AI check of new reports (any OpenAI-compatible API). The key stays on the server.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_VERIFY_THRESHOLD=85
AI_REVIEW_THRESHOLD=50

# Rules
CASE_PREFIX=EL
DUPLICATE_RADIUS_METERS=50
AUTO_CLOSE_RESOLVED_DAYS=7
# Reports must be pinned inside this box: minLat,minLng,maxLat,maxLng
SERVICE_AREA_BBOX=40.85,19.75,41.35,20.45
# New reports per IP address per hour, and login attempts per 15 minutes.
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_LOGINS_PER_15MIN=10
# Sites allowed to show the embedded form (iframe) before the admin edits the list.
EMBED_ALLOWED_ORIGINS=https://elbasani.gov.al,https://www.elbasani.gov.al
