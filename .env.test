# Automated tests (npm test). Uses its own database, emptied on every run.
APP_ENV=test
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://raporton:raporton@localhost:5432/raporton_next_test
AUTH_SECRET=test-only-secret-not-for-production-0123456789abcdef
ADMIN_EMAIL=admin@test.local
BCRYPT_ROUNDS=4
LOCAL_UPLOAD_DIR=.uploads-test
MAIL_DRIVER=log
AI_ENABLED=false
CRON_SECRET=test-cron-secret
RATE_LIMIT_REPORTS_PER_HOUR=10000
RATE_LIMIT_LOGINS_PER_15MIN=10000
