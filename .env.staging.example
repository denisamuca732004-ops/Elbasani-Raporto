# ─────────────────────────────────────────────────────────────
# STAGING – the test site used during mentoring and the pilot.
# Copy each line to Vercel → Settings → Environment Variables → "Preview".
# Replace every SET_ON_SERVER. The app refuses to start while one is left.
# ─────────────────────────────────────────────────────────────
APP_ENV=staging
APP_URL=https://staging.raporto.elbasani.gov.al
DATABASE_URL=SET_ON_SERVER
DIRECT_URL=SET_ON_SERVER
AUTH_SECRET=SET_ON_SERVER
SESSION_MAX_AGE_HOURS=12
# Residents' own accounts stay signed in this many days (staff: SESSION_MAX_AGE_HOURS above).
RESIDENT_SESSION_DAYS=30
# Optional: "Continue with Google" for residents. From Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application), with the redirect URI https://<domain>/api/auth/callback/google.
# Without both values the Google button is simply not shown.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=SET_ON_SERVER
BCRYPT_ROUNDS=11
BLOB_READ_WRITE_TOKEN=SET_ON_SERVER
UPSTASH_REDIS_REST_URL=SET_ON_SERVER
UPSTASH_REDIS_REST_TOKEN=SET_ON_SERVER
QSTASH_TOKEN=SET_ON_SERVER
QSTASH_CURRENT_SIGNING_KEY=SET_ON_SERVER
QSTASH_NEXT_SIGNING_KEY=SET_ON_SERVER
CRON_SECRET=SET_ON_SERVER
# Staging keeps emails in the Email log until the municipality gives a verified sender.
MAIL_DRIVER=log
MAIL_FROM="Elbasani Raporton (staging) <noreply@elbasani.gov.al>"
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=SET_ON_SERVER
AI_MODEL=gpt-4o-mini
AUTO_CLOSE_RESOLVED_DAYS=7
RATE_LIMIT_REPORTS_PER_HOUR=10
