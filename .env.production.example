# ─────────────────────────────────────────────────────────────
# PRODUCTION – the live site.
# Copy each line to Vercel → Settings → Environment Variables → "Production".
# Replace every SET_ON_SERVER. The app refuses to start while one is left.
# ─────────────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://raporto.elbasani.gov.al
DATABASE_URL=SET_ON_SERVER
DIRECT_URL=SET_ON_SERVER
AUTH_SECRET=SET_ON_SERVER
SESSION_MAX_AGE_HOURS=12
ADMIN_EMAIL=SET_ON_SERVER
BCRYPT_ROUNDS=11
BLOB_READ_WRITE_TOKEN=SET_ON_SERVER
UPSTASH_REDIS_REST_URL=SET_ON_SERVER
UPSTASH_REDIS_REST_TOKEN=SET_ON_SERVER
QSTASH_TOKEN=SET_ON_SERVER
QSTASH_CURRENT_SIGNING_KEY=SET_ON_SERVER
QSTASH_NEXT_SIGNING_KEY=SET_ON_SERVER
CRON_SECRET=SET_ON_SERVER
MAIL_DRIVER=smtp
SMTP_HOST=SET_ON_SERVER
SMTP_PORT=587
SMTP_USER=SET_ON_SERVER
SMTP_PASS=SET_ON_SERVER
MAIL_FROM="Elbasani Raporton <noreply@elbasani.gov.al>"
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=SET_ON_SERVER
AI_MODEL=gpt-4o-mini
AUTO_CLOSE_RESOLVED_DAYS=7
RATE_LIMIT_REPORTS_PER_HOUR=10
